    "changes": [
      {
        "locale": "en",
        "unitId": "spatial-u981e7960dbf254bd97-1",
        "field": "text",
        "sourceIndex": 432,
        "before": "concentrating intellectual, financial, organizational and infrastructure resources on supporting scientific and technical programs and full-innovation-cycle projects needed to respond to regional, nationwide and international challenges;",
        "after": "concentrating intellectual, financial, organizational and infrastructure resources on supporting scientific and scientific-technical programs and projects covering the full innovation cycle, needed to respond to regional, nationwide and international challenges;",
        "semanticReview": "accepted"
      },
      {
        "locale": "en",
        "unitId": "spatial-u0c4ad6632d01de2453-1",
        "field": "text",
        "sourceIndex": 503,
        "before": "ensuring balance in regional labor markets and reducing population outflows, including by increasing the share of high-productivity jobs, optimizing the structure of personnel training in light of the Urals Federal District’s economic needs in achieving technological independence, transitioning to technologies with less adverse impact on the environment and climate, and reclaiming exhausted mineral deposit sites;",
        "after": "ensuring balance in regional labor markets and reducing population outflows, including by increasing the share of high-productivity jobs and optimizing the structure of personnel training, taking account of the needs of the Urals Federal District’s economy relating to the achievement of technological independence, the transition to technologies with less adverse impact on the environment and climate, and the reclamation of exhausted mineral deposit sites;",
        "semanticReview": "accepted"
      },
      {
        "locale": "en",
        "unitId": "spatial-ud2b847e4fe74bfa3ed-1",
        "field": "text",
        "sourceIndex": 525,
        "before": "integrating the new constituent entities of the Russian Federation into the country’s common economic space, including the unified core transport network, and ensuring a quality of life no lower than the Russian average, taking account of the state program of the Russian Federation “Restoration and Socioeconomic Development of the Donetsk People’s Republic, the Lugansk People’s Republic, Zaporozhye Oblast and Kherson Oblast”; this includes creating a unified economic space in the Azov Sea region by 2028 through transport connectivity between the new constituent entities of the Russian Federation, the Republic of Crimea and the city of Sevastopol and the Azov Sea and other neighboring constituent entities of the Russian Federation, namely Krasnodar Krai and Belgorod, Voronezh and Rostov Oblasts;",
        "after": "integrating the new constituent entities of the Russian Federation into the country’s common economic space, including the unified core transport network, and ensuring a quality of life no lower than the Russian average, taking account of the state program of the Russian Federation “Restoration and Socioeconomic Development of the Donetsk People’s Republic, the Lugansk People’s Republic, Zaporozhye Oblast and Kherson Oblast”; this includes creating a unified economic space in the Azov Sea region by 2028 through transport connectivity between the new constituent entities of the Russian Federation, the Republic of Crimea and the city of Sevastopol and the constituent entities of the Russian Federation on the Sea of Azov and other constituent entities bordering the aforementioned territories, namely Krasnodar Krai and Belgorod, Voronezh and Rostov Oblasts;",
        "semanticReview": "accepted"
      },
      {
        "locale": "zh",
        "unitId": "spatial-ua137b5172db8ed57b1-1",
        "field": "text",
        "sourceIndex": 324,
        "before": "对不同地区住房建设的国家支持措施采取差异化方法，包括考虑住房保障程度和住房需求，同时优先考虑城市群、实施对经济和就业增长有重大影响的大型投资项目的支点居民点，以及俄罗斯联邦地缘战略区域；",
        "after": "对不同地区住房建设的国家支持措施采取差异化方法，包括考虑住房保障程度和住房需求，同时优先考虑实施对经济和居民就业增长有重大影响的大型投资项目的城市群和支点居民点，以及俄罗斯联邦地缘战略区域；",
        "semanticReview": "accepted"
      },
      {
        "locale": "zh",
        "unitId": "spatial-u981e7960dbf254bd97-1",
        "field": "text",
        "sourceIndex": 432,
        "before": "集中智力、资金、组织和基础设施资源，支持应对区域、全俄和国际挑战所需的科学、科技计划及涵盖完整创新周期的项目；",
        "after": "集中智力、资金、组织和基础设施资源，支持应对区域、全俄和国际挑战所需、涵盖完整创新周期的科学及科技计划和项目；",
        "semanticReview": "accepted"
      },
