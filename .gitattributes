# The imported game is a byte-verified source artifact on every operating system.
site/apps/settlements/runtime/** -text
site/apps/settlements/source-manifest.json text eol=lf
scripts/test-settlements-replay.mjs text eol=lf
scripts/summarize-settlements-replay.mjs text eol=lf
# Resource digests must identify the same bytes on Windows and on Pages.
site/apps/legal-lab/** text=auto eol=lf

# Independent review evidence is hashed verbatim, including its original line endings.
docs/quality/legal-document-translations/** -text whitespace=cr-at-eol

# Retired source evidence preserves its original bytes.
tests/fixtures/legal-lab-retired-corpus/** -text whitespace=cr-at-eol
