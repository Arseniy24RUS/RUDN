      "source-index:SOURCE_INDEX.entries[shelf:mos].cases[mfc-typo-refusal].title"
    ]
  },
  {
    "id": "deb1a310280d7400",
    "ru": "Исправление документов",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-typo-refusal].topic",
      "cases:CASE_TEMPLATES[mfc-typo-refusal].tag"
    ]
  },
  {
    "id": "4c4953e7943d309a",
    "ru": "Различить получение документа и право оспаривать отказ исправить ошибку.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-typo-refusal].trap.options[0].text",
      "cases:CASE_TEMPLATES[mfc-typo-refusal].trap.explain"
    ]
  },
  {
    "id": "2f73d98348750858",
    "ru": "Отклонить жалобу по подписи.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-typo-refusal].trap.options[1].text"
    ]
  },
  {
    "id": "b9131c2d3a699f84",
    "ru": "Помощник: «Подписала получение – значит жалоба невозможна».",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-typo-refusal].trap.text"
    ]
  },
  {
    "id": "f58ae4c6afa42c42",
    "ru": "Сверить предмет отказа и место приёма",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].actions[a0].title"
    ]
  },
  {
    "id": "5bea381fdb51ba29",
    "ru": "Проверить, что документ надлежащий и допускается добровольное представление",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].actions[a1].title"
    ]
  },
  {
    "id": "5bd26e234dd5a364",
    "ru": "Подготовить оценку отказа по соответствующей процедуре",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].actions[a2].title"
    ]
  },
  {
    "id": "24aba601eb083a5d",
    "ru": "Разъяснить право представить сведения по инициативе без превращения его в обязанность",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].actions[a3].title"
    ]
  },
  {
    "id": "8a412ff50183e0f2",
    "ru": "Проверить принятие материала и сохранение межведомственного способа для остальных случаев",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].actions[a4].title"
    ]
  },
  {
    "id": "75046f567f46d1e1",
    "ru": "Требовать такую справку у всех заявителей после удовлетворения жалобы",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].actions[b0].title",
      "cases:CASE_TEMPLATES[mfc-voluntary-document].criticalRules[b0].message"
    ]
  },
  {
    "id": "f4bb067cb66e8ae7",
    "ru": "Отказать повторно только из-за наличия межведомственного обмена",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].actions[b1].title"
    ]
  },
  {
    "id": "459960ab7c39e01b",
    "ru": "Крайний день рассмотрения жалобы на отказ в приёме",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].calendar.title",
      "cases:CASE_TEMPLATES[mfc-territorial-choice].calendar.title"
    ]
  },
  {
    "id": "fc00825905b85348",
    "ru": "Заявителя не заставляют собирать справку: он сам предлагает допустимый документ; отказ в его приёме требует другого решения.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].contrast.difference"
    ]
  },
  {
    "id": "f0650cc1f5d7b246",
    "ru": "В вымышленном деле гражданин добровольно представил надлежащий документ из числа получаемых межведомственно. Правила выбранной услуги допускают такое представление. Работник органа отказал только потому, что сведения можно получить без заявителя; иных оснований не установлено.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].documents[d0].text"
    ]
  },
  {
    "id": "680afa64b9480c84",
    "ru": "Отказ и условия представления",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].documents[d0].title"
    ]
  },
  {
    "id": "6aee20a55f1b9cf8",
    "ru": "Приём проводил орган, предоставляющий услугу, не сотрудник МФЦ. Жалоба зарегистрирована этим органом; специальная федеральная процедура вне главы 2.1 не применяется.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].documents[d1].text"
    ]
  },
  {
    "id": "3d38f703ae81baeb",
    "ru": "Подтверждение адресата",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].documents[d1].title"
    ]
  },
  {
    "id": "eefb8e5019eba32f",
    "ru": "Запрет требовать межведомственный документ не равен запрету принять его по инициативе заявителя.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].factTask.options[0].text",
      "cases:CASE_TEMPLATES[mfc-voluntary-document].factTask.explain",
      "cases:CASE_TEMPLATES[mfc-voluntary-document].outcomes.good"
    ]
  },
  {
    "id": "0e8d950babee9745",
    "ru": "Межведомственный обмен делает любое добровольное представление незаконным.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].factTask.options[1].text"
    ]
  },
  {
    "id": "941ac85ec0c4ad8d",
    "ru": "Приём добровольной справки позволяет сделать её обязательной для следующих заявителей.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].factTask.options[2].text"
    ]
  },
  {
    "id": "c25c8d94dffc83f4",
    "ru": "Учебное продолжение. Документ приняли, но в обновлённой памятке его назвали обязательным для всех.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].followup.intro"
    ]
  },
  {
    "id": "3223e11713033e4d",
    "ru": "Исправить превращение добровольного способа в обязанность и сохранить возможность межведомственного получения.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].followup.options[0].text",
      "cases:CASE_TEMPLATES[mfc-voluntary-document].followup.explain"
    ]
  },
  {
    "id": "ba34ffa9a1913f51",
    "ru": "Согласовать памятку, потому что так меньше работы у органа.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].followup.options[1].text"
    ]
  },
  {
    "id": "964ada3f51082205",
    "ru": "Запретить всем заявителям добровольно представлять сведения.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].followup.options[2].text"
    ]
  },
  {
    "id": "517255114da73f56",
    "ru": "Рассмотреть отказ в приёме надлежащего добровольного документа и не вводить его обязательность.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].knowledge.options[0].text",
      "cases:CASE_TEMPLATES[mfc-voluntary-document].knowledge.explain",
      "cases:CASE_TEMPLATES[mfc-voluntary-document].coach.research"
    ]
  },
  {
    "id": "ef5b868be5e1a0c5",
    "ru": "Справка не обязательна: орган может запросить её сам. Я уже получил её и принёс добровольно. В приёмной органа сказали, что раз существует межведомственный обмен, мой документ вообще не имеют права принять.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].opening"
    ]
  },
  {
    "id": "381b00675ac672be",
    "ru": "В орган, предоставляющий услугу; МФЦ в этом приёме не участвовал.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].questions[q0].answer"
    ]
  },
  {
    "id": "bb36500b06058134",
    "ru": "Устанавливается надлежащий адресат жалобы.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].questions[q0].fact"
    ]
  },
  {
    "id": "1a007ef8e21832c0",
    "ru": "Куда вы принесли документ?",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].questions[q0].text"
    ]
  },
  {
    "id": "629a1d5219f61674",
    "ru": "Да. Учебные условия допускают его добровольное представление.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].questions[q1].answer"
    ]
  },
  {
    "id": "3e1a5883adf7ab17",
    "ru": "Добровольность отличается от обязательного требования.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].questions[q1].fact"
    ]
  },
  {
    "id": "385a6b42d035d4e5",
    "ru": "Документ включён в круг межведомственных сведений?",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].questions[q1].text"
    ]
  },
  {
    "id": "645d9d161d483144",
    "ru": "Отказали в его приёме, не рассматривая действительность. Подтверждение отказа есть.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].questions[q2].answer"
    ]
  },
  {
    "id": "540a4738209c757a",
    "ru": "Предметом является отказ в приёме.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].questions[q2].fact"
    ]
  },
  {
    "id": "6791e4c182b249cb",
    "ru": "Что произошло с документом?",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].questions[q2].text"
    ]
  },
  {
    "id": "9fa6991f9f4559c2",
    "ru": "В материалах указано только наличие межведомственного обмена; документ надлежащий.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].questions[q3].answer"
    ]
  },
  {
    "id": "4ae015c9f5288bf2",
    "ru": "Не дописываем неизвестные основания.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].questions[q3].fact"
    ]
  },
  {
    "id": "720cb9b1c6bab69d",
    "ru": "Есть ли иная причина отказа?",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].questions[q3].text"
    ]
  },
  {
    "id": "8fee04a7ff0e4665",
    "ru": "Подготовить рассмотрение жалобы уполномоченным лицом органа, предоставляющего услугу, на отказ в приёме добровольно представленного документа.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].routes[0].text",
      "cases:CASE_TEMPLATES[mfc-voluntary-document].coach.plan"
    ]
  },
  {
    "id": "9aa5a71dfb5d1d5b",
    "ru": "Направить жалобу руководителю МФЦ, который в этом приёме не участвовал.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].routes[1].text",
      "cases:CASE_TEMPLATES[mfc-voluntary-document].knowledge.options[1].text",
      "evidence-catalog:EVIDENCE_TASKS.v09-mfc-voluntary-document.findingOptions[1].text"
    ]
  },
  {
    "id": "af566bb4941d68cf",
    "ru": "Ввести для всех обязанность самостоятельно приносить такую справку.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].routes[2].text",
      "cases:CASE_TEMPLATES[mfc-voluntary-document].knowledge.options[2].text",
      "evidence-catalog:EVIDENCE_TASKS.v09-mfc-voluntary-document.findingOptions[2].text"
    ]
  },
  {
    "id": "13ef4443eabb8cdd",
    "ru": "Сведения принёс сам заявитель",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].title",
      "source-index:SOURCE_INDEX.entries[shelf:59].cases[mfc-voluntary-document].title",
      "source-index:SOURCE_INDEX.entries[shelf:mos].cases[mfc-voluntary-document].title"
    ]
  },
  {
    "id": "453272e0a30fa2ab",
    "ru": "Добровольное представление и обязательное требование имеют разные правовые последствия.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].trap.options[0].text",
      "cases:CASE_TEMPLATES[mfc-voluntary-document].trap.explain"
    ]
  },
  {
    "id": "269c348e5199da9f",
    "ru": "Любой добровольный документ нужно вернуть.",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].trap.options[1].text"
    ]
  },
  {
    "id": "7293866ac0d900a6",
    "ru": "Помощник: «Нельзя требовать» означает «нельзя принять».",
    "contexts": [
      "cases:CASE_TEMPLATES[mfc-voluntary-document].trap.text"
    ]
  },
  {
    "id": "21d3f6a9e0f87aad",
    "ru": "Сопоставить место, время и операции с карточкой А-22.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].actions[a0].title"
    ]
  },
  {
    "id": "32c9f5c0a81ea1b5",
    "ru": "Проверить необходимость аварийной операции по материалам.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].actions[a1].title"
    ]
  },
  {
    "id": "69bb6bcd36fc2eda",
    "ru": "Подготовить мотивированный ответ о конкретном исключении.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].actions[a2].title"
    ]
  },
  {
    "id": "85fe4d775ca5c9f5",
    "ru": "Не распространять исключение на любые будущие работы.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].actions[a3].title"
    ]
  },
  {
    "id": "9127f8b8a4f36b9d",
    "ru": "Оценивать дальнейшие эпизоды по их собственным обстоятельствам.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].actions[a4].title"
    ]
  },
  {
    "id": "c6331870b28385ff",
    "ru": "Считать ночь достаточным основанием для штрафа.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].actions[b0].title"
    ]
  },
  {
    "id": "96d02d064b740e09",
    "ru": "Выдать разрешение на любой последующий ночной ремонт.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].actions[b1].title",
      "cases:CASE_TEMPLATES[noise-emergency-work].criticalRules[b1].message"
    ]
  },
  {
    "id": "4f3d716be8fa035c",
    "ru": "Все граждане, организации-участники и служебные документы вымышлены. Город Москва, аварийный прорыв сети подтверждён. Шумные операции в исходном эпизоде были необходимой частью неотложных работ для предотвращения угрозы; это установлено документами, а не только заявлением подрядчика. Требования безопасности и оценка иных последствий сохраняются.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].brief"
    ]
  },
  {
    "id": "546437f1a14f85fb",
    "ru": "В отличие от бытового нарушения в исходных материалах подтверждены условия специального исключения.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].coach.plan",
      "cases:CASE_TEMPLATES[noise-emergency-work].contrast.difference"
    ]
  },
  {
    "id": "f2ae4640faaecb56",
    "ru": "На следующий месяц предусмотрена перекладка покрытия. Это не объяснение ночного аварийного эпизода.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].documents[d0].text"
    ]
  },
  {
    "id": "b60119c893da8637",
    "ru": "Обычный план благоустройства",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].documents[d0].title"
    ]
  },
  {
    "id": "63d9546c11c9e261",
    "ru": "{{observed}}, 00:20: прорыв сети, угроза затопления электрооборудования. Неотложное устранение до 02:10. Адрес и место совпадают с обращением.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].documents[d1].text"
    ]
  },
  {
    "id": "7a1c75d389373be9",
    "ru": "Карточка аварии А-22",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].documents[d1].title"
    ]
  },
  {
    "id": "a34f61583cc37a9b",
    "ru": "Резка трубы с 00:40 до 01:20 необходима для локализации именно А-22. Пункт 2 статьи 2 Закона Москвы №42 исключает из своего режима действия по предотвращению и ликвидации последствий аварий и установленные неотложные работы; это не освобождение любых последующих работ.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].documents[d2].text"
    ]
  },
  {
    "id": "659a328ff4d2512d",
    "ru": "Акт работ и применимое исключение",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].documents[d2].title"
    ]
  },
  {
    "id": "aaf14bd012b8cd54",
    "ru": "В исходном эпизоде подтверждено применимое исключение для неотложной аварийной работы, а не общее право шуметь ночью. В отличие от бытового нарушения в исходных материалах подтверждены условия специального исключения.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].factTask.explain",
      "evidence-catalog:EVIDENCE_TASKS.v13-noise-emergency-work.explain"
    ]
  },
  {
    "id": "f475b9c1cbbccda9",
    "ru": "В исходном эпизоде подтверждено применимое исключение для неотложной аварийной работы, а не общее право шуметь ночью.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].factTask.options[0].text",
      "cases:CASE_TEMPLATES[noise-emergency-work].trap.explain",
      "cases:CASE_TEMPLATES[noise-emergency-work].contrast.decision"
    ]
  },
  {
    "id": "e3d068cb949e9ba6",
    "ru": "Ночное время автоматически делает противоправной любую аварийную операцию.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].factTask.options[1].text",
      "evidence-catalog:EVIDENCE_TASKS.v13-noise-emergency-work.findingOptions[1].text"
    ]
  },
  {
    "id": "4b3681c5bede4861",
    "ru": "Одно аварийное событие навсегда освобождает подрядчика от ограничений.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].factTask.options[2].text",
      "evidence-catalog:EVIDENCE_TASKS.v13-noise-emergency-work.findingOptions[2].text"
    ]
  },
  {
    "id": "78194aff6518e9b7",
    "ru": "На следующую ночь без аварии начали обычное восстановление покрытия.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].followup.intro"
    ]
  },
  {
    "id": "5a972ea10866672c",
    "ru": "Рассмотреть новый эпизод отдельно; прежнее аварийное исключение не переносится автоматически.",
    "contexts": [
      "cases:CASE_TEMPLATES[noise-emergency-work].followup.options[0].text",
      "cases:CASE_TEMPLATES[noise-emergency-work].followup.explain"
    ]
  },
  {
    "id": "e03e6625aa2f5a26",
