    ]
  },
  {
    "id": "7e48f27656f3ca31",
    "ru": "Обновление применяется только к новым сменам. Для обновления нужно подключение к интернету.",
    "contexts": [
      "standalone.js:69"
    ]
  },
  {
    "id": "8fd0e4025788a2e0",
